/** app.wxss — 全局样式 — 设计图美化版 */

/* 主题色变量 */
page {
  --color-primary: #F97316;
  --color-primary-light: #FFEDD5;
  --color-secondary: #EC4899;
  --color-secondary-light: #FDF2F8;
  --color-accent: #F59E0B;
  --color-earn: #F59E0B;
  --color-earn-bg: #FFFBEB;
  --color-earn-border: #FDE68A;
  --color-deduct: #EF4444;
  --color-deduct-bg: #FEF2F2;
  --color-deduct-border: #FECACA;
  --color-spend: #EC4899;
  --color-spend-bg: #FDF2F8;
  --color-spend-border: #FBCFE8;
  --color-bg: #FFF9F0;
  --color-card: #FFFFFF;
  --color-text: #1C1917;
  --color-text-secondary: #78716C;
  --color-text-muted: #A8A29E;
  --color-border: #E7E5E4;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 32rpx;
  --radius-full: 99999rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.06);
  --shadow-md: 0 4rpx 16rpx rgba(0,0,0,0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(0,0,0,0.12);
  --shadow-glow-yellow: 0 4rpx 20rpx rgba(245,158,11,0.25);
  --shadow-glow-red: 0 4rpx 20rpx rgba(239,68,68,0.2);
  --shadow-glow-pink: 0 4rpx 20rpx rgba(236,72,153,0.2);
}

/* 毛玻璃效果 */
.glass {
  background: rgba(255,255,255,0.82);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255,255,255,0.4);
}

/* 页面容器 */
.page {
  height: 100vh;
  overflow-y: auto;
  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: #1e293b;
  padding-bottom: 40rpx;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
}

/* 弹性布局 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.justify-end { justify-content: flex-end; }
.gap-1 { gap: 4rpx; }
.gap-2 { gap: 8rpx; }
.gap-3 { gap: 12rpx; }
.gap-4 { gap: 16rpx; }

/* 间距 */
.mt-1 { margin-top: 4rpx; }
.mt-2 { margin-top: 8rpx; }
.mt-3 { margin-top: 12rpx; }
.mt-4 { margin-top: 16rpx; }
.mt-5 { margin-top: 20rpx; }
.mb-1 { margin-bottom: 4rpx; }
.mb-2 { margin-bottom: 8rpx; }
.mb-3 { margin-bottom: 12rpx; }
.mb-4 { margin-bottom: 16rpx; }

.pt-4 { padding-top: 16rpx; }
.pb-4 { padding-bottom: 16rpx; }
.pb-20 { padding-bottom: 160rpx; }

/* 布局宽度 */
.w-full { width: 100%; }
.max-w-md { max-width: 580rpx; }
.mx-auto { margin-left: auto; margin-right: auto; }

/* 文字 */
.text-xs { font-size: 20rpx; }
.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 40rpx; }
.text-6xl { font-size: 80rpx; }

.font-medium { font-weight: 500; }
.font-bold { font-weight: 700; }
.font-black { font-weight: 900; }

.text-center { text-align: center; }

/* 颜色 — slate */
.text-slate-400 { color: #94a3b8; }
.text-slate-500 { color: #64748b; }
.text-slate-600 { color: #475569; }
.text-slate-700 { color: #334155; }
.text-slate-800 { color: #1e293b; }
.bg-slate-50 { background-color: #f8fafc; }
.bg-slate-100 { background-color: #f1f5f9; }
.bg-slate-200 { background-color: #e2e8f0; }
.bg-slate-300 { background-color: #cbd5e1; }

/* 圆角 */
.rounded-sm { border-radius: 4rpx; }
.rounded { border-radius: 8rpx; }
.rounded-lg { border-radius: 12rpx; }
.rounded-xl { border-radius: 16rpx; }
.rounded-2xl { border-radius: 20rpx; }
.rounded-3xl { border-radius: 24rpx; }
.rounded-full { border-radius: 99999rpx; }

/* 阴影 */
.shadow-sm { box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.05); }
.shadow-md { box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08); }
.shadow-lg { box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12); }
.shadow-xl { box-shadow: 0 16rpx 32rpx rgba(0,0,0,0.15); }
.shadow-inner { box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,0.05); }
.shadow-card { box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }

/* 渐变文字 */
.gradient-text {
  background: linear-gradient(135deg, #F59E0B, #F97316);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 星星浮动装饰 */
@keyframes floatStar {
  0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.4; }
  50% { transform: translateY(-12rpx) rotate(180deg); opacity: 0.8; }
}
@keyframes floatUp {
  0% { transform: translateY(0); opacity: 0.8; }
  100% { transform: translateY(-60rpx); opacity: 0; }
}
.float-up { animation: floatUp 1.2s ease-out forwards; }
@keyframes scaleIn {
  0% { transform: scale(0.85); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.scale-in { animation: scaleIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

/* 通用页面头部导航 */
.page-header {
  position: relative;
  padding: 0 32rpx 24rpx;
}
.page-header-inner {
  max-width: 580rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-header-back {
  width: 60rpx; height: 60rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 99999rpx;
  background: rgba(255,255,255,0.92);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.page-header-back:active { background: #f5f5f4; }
.page-header-back-icon { font-size: 32rpx; color: #292524; line-height: 1; }
.page-header-title { font-size: 28rpx; font-weight: 700; color: #292524; }
.page-header-actions { width: 60rpx; display: flex; justify-content: flex-end; }

/* 通用内容区 */
.page-content {
  padding: 0 32rpx 48rpx;
  max-width: 580rpx;
  margin: 0 auto;
}

/* 通用空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}
.empty-state-icon { font-size: 64rpx; display: block; margin-bottom: 24rpx; }
.empty-state-text { font-size: 28rpx; color: var(--color-text-muted); }

/* 通用通知/Toast */
.toast {
  position: fixed;
  bottom: 48rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 999;
}

/* 边框 */
.border { border-width: 2rpx; border-style: solid; }
.border-0 { border-width: 0; }
.border-b { border-bottom-width: 2rpx; border-bottom-style: solid; }
.border-dashed { border-style: dashed; }

/* 透明度 */
.opacity-90 { opacity: 0.9; }

/* 其他 */
.overflow-hidden { overflow: hidden; }
.relative { position: relative; }
.absolute { position: absolute; }
.fixed { position: fixed; }
.inset-0 { top: 0; right: 0; bottom: 0; left: 0; }
.z-10 { z-index: 10; }
.z-20 { z-index: 20; }
.z-30 { z-index: 30; }
.z-50 { z-index: 50; }

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes bounceIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}
.animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
.animate-bounce-in { animation: bounceIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

/* 按钮重置 */
button {
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}
button::after { border: none; }

/* 输入框重置 */
input {
  border: none;
  outline: none;
  background: none;
}

/* 滚动条隐藏 */
.hide-scrollbar::-webkit-scrollbar { display: none; }
.hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
