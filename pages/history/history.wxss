/* 导航栏 */
.nav-header {
  background: #ffffff;
  padding: 64rpx 32rpx 24rpx;
  border-bottom: 2rpx solid #f1f5f9;
  position: sticky;
  top: 0;
  z-index: 30;
}
.nav-inner {
  max-width: 580rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 99999rpx;
}
.nav-back:active {
  background: #f1f5f9;
}
.nav-back-arrow {
  font-size: 36rpx;
  color: #64748b;
}
.nav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #334155;
}
.nav-placeholder {
  width: 64rpx;
}

/* 内容 */
.content-area {
  padding: 24rpx 32rpx 48rpx;
  max-width: 580rpx;
  margin: 0 auto;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #475569;
}
.clear-btn {
  padding: 8rpx 16rpx;
}
.clear-btn:active {
  opacity: 0.7;
}
.clear-text {
  font-size: 22rpx;
  color: #f87171;
}

.empty-box {
  text-align: center;
  padding: 96rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  border: 4rpx dashed #f1f5f9;
}
.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
}

/* 历史列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.history-item {
  background: #ffffff;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.history-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.history-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 99999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.history-icon-earn { background: #fefce8; }
.history-icon-spend { background: #fdf2f8; }
.history-icon-deduct { background: #fef2f2; }
.history-info {
  flex: 1;
  min-width: 0;
}
.history-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
  display: block;
  line-height: 1.4;
}
.history-date {
  font-size: 20rpx;
  color: #94a3b8;
  display: block;
  margin-top: 4rpx;
}
.history-value {
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.text-yellow { color: #ca8a04; }
.text-blue { color: #2563eb; }
.text-red { color: #dc2626; }

/* 模态框 */
.modal-overlay {
  position: fixed; inset: 0; z-index: 50;
  display: flex; align-items: center; justify-content: center;
  padding: 32rpx; background: rgba(0,0,0,0.5);
}
.modal-box {
  background: #ffffff; border-radius: 24rpx;
  width: 100%; max-width: 480rpx; padding: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.2);
}
.modal-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.modal-warn-emoji { font-size: 36rpx; }
.modal-title { font-size: 32rpx; font-weight: 700; color: #1e293b; }
.modal-title-danger { color: #dc2626; }
.modal-message { font-size: 24rpx; color: #475569; margin-bottom: 40rpx; line-height: 1.5; }
.modal-actions { display: flex; gap: 16rpx; }
.modal-btn { flex: 1; padding: 24rpx 0; border-radius: 12rpx; font-weight: 700; font-size: 24rpx; text-align: center; }
.modal-btn:active { opacity: 0.8; }
.modal-btn-cancel { background: #f1f5f9; color: #334155; }
.modal-btn-confirm { background: #3b82f6; color: #ffffff; box-shadow: 0 4rpx 12rpx rgba(59,130,246,0.3); }
.modal-btn-danger { background: #ef4444; color: #ffffff; box-shadow: 0 4rpx 12rpx rgba(239,68,68,0.3); }

/* 通知 */
.notification {
  position: fixed; bottom: 48rpx; left: 50%; transform: translateX(-50%);
  padding: 20rpx 40rpx; border-radius: 99999rpx;
  display: flex; align-items: center; gap: 12rpx;
  z-index: 50; box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
  animation: bounceIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}
.notification-success { background: #1e293b; }
.notification-error { background: #ef4444; }
.notification-icon { font-size: 24rpx; color: #ffffff; }
.notification-text { font-size: 24rpx; font-weight: 500; color: #ffffff; }

@keyframes bounceIn {
  from { opacity: 0; transform: scale(0.9) translateX(-50%); }
  to { opacity: 1; transform: scale(1) translateX(-50%); }
}
