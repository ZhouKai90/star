/* ===== 页面头部 ===== */
.page-content { max-width: 100%; }

.header-area-sm {
  background: linear-gradient(165deg, #FB923C, #F97316);
  padding: 0 32rpx 28rpx;
}
.nav-clear-btn { padding: 8rpx; }
.nav-clear-text { font-size: 22rpx; color: rgba(255,255,255,0.7); font-weight: 500; }
.nav-clear-btn:active { opacity: 0.7; }

/* ===== 日历卡片 ===== */
.cal-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.month-summary {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.month-summary-item {
  flex: 1;
  min-width: 0;
  padding: 18rpx 16rpx;
  border-radius: 18rpx;
  background: #FAFAF9;
}

.month-summary-label {
  display: block;
  font-size: 20rpx;
  color: #A8A29E;
  line-height: 1.2;
}

.month-summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
}

.month-summary-value-earn { color: #D97706; }
.month-summary-value-out { color: #DC2626; }
.month-summary-value-days { color: #57534E; }

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.month-btn {
  width: 60rpx; height: 60rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 99999rpx;
  font-size: 32rpx; color: #78716C; font-weight: 300;
}
.month-btn:active { background: #F5F5F4; }
.month-title { font-size: 30rpx; font-weight: 700; color: #292524; }

.week-row { display: flex; margin-bottom: 8rpx; }
.week-cell { flex: 1; text-align: center; padding: 8rpx 0; }
.week-text { font-size: 22rpx; font-weight: 600; color: #A8A29E; }

.cal-grid { display: flex; flex-wrap: wrap; }
.day-cell {
  width: calc(100% / 7);
  padding: 10rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  position: relative;
  border-radius: 14rpx;
}
.day-cell:active { background: #F5F5F4; }
.day-dim .day-num { color: #D6D3D1; }
.day-num { font-size: 26rpx; font-weight: 500; color: #57534E; line-height: 1.3; }
.day-today .day-num { font-weight: 800; color: #F97316; }
.day-selected { background: linear-gradient(135deg, #F97316, #F59E0B); }
.day-selected .day-num { color: #FFFFFF; font-weight: 700; }
.day-selected:active { opacity: 0.9; }
.day-has-record::after {
  content: ''; position: absolute; top: 6rpx; right: 6rpx;
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: #EF4444;
}
.day-selected.day-has-record::after { background: rgba(255,255,255,0.7); }

/* ===== 每日详情 ===== */
.detail-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.detail-top { padding: 28rpx 28rpx 0; }
.detail-title { font-size: 28rpx; font-weight: 700; color: #292524; }

.detail-summary {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 28rpx 0;
}
.stat-item {
  flex: 1;
  background: #FAFAF9;
  border-radius: 16rpx;
  padding: 16rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.stat-label { font-size: 20rpx; color: #A8A29E; font-weight: 500; }
.stat-val { font-size: 28rpx; font-weight: 800; }
.stat-val-earn { color: #D97706; }
.stat-val-deduct { color: #DC2626; }
.stat-val-spend { color: #DB2777; }

.detail-list { padding: 20rpx 28rpx 28rpx; display: flex; flex-direction: column; gap: 12rpx; }
.record-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 20rpx; border-radius: 18rpx; border: 2rpx solid #F5F5F4;
}
.record-left {
  display: flex; align-items: center; gap: 14rpx; flex: 1; min-width: 0;
}
.record-icon {
  width: 56rpx; height: 56rpx; border-radius: 99999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; flex-shrink: 0;
}
.ri-earn { background: #FFFBEB; }
.ri-spend { background: #FDF2F8; }
.ri-deduct { background: #FEF2F2; }
.record-info { flex: 1; min-width: 0; }
.record-title { font-size: 24rpx; font-weight: 600; color: #292524; display: block; line-height: 1.4; }
.record-time { font-size: 20rpx; color: #A8A29E; display: block; margin-top: 2rpx; }
.record-val { font-size: 24rpx; font-weight: 700; flex-shrink: 0; margin-left: 12rpx; }
.rv-earn { color: #D97706; }
.rv-deduct { color: #DC2626; }
.rv-spend { color: #DB2777; }

/* ===== 模态框 ===== */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999;
  display: flex; align-items: flex-end; justify-content: center;
  background: rgba(0,0,0,0.5);
}
.modal-sheet {
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-radius: 32rpx 32rpx 0 0;
  width: 100%; padding: 20rpx 32rpx 48rpx;
  max-width: 580rpx; text-align: center;
}
.modal-handle { width: 48rpx; height: 6rpx; border-radius: 99rpx; background: #D6D3D1; margin: 0 auto 24rpx; }
.modal-emoji { font-size: 56rpx; display: block; margin-bottom: 16rpx; }
.modal-title { font-size: 32rpx; font-weight: 800; color: #292524; display: block; margin-bottom: 12rpx; }
.modal-title-danger { color: #DC2626; }
.modal-desc { font-size: 26rpx; color: #78716C; margin-bottom: 36rpx; line-height: 1.5; }
.modal-btns { display: flex; gap: 16rpx; }
.modal-btn-cancel {
  flex: 1; padding: 24rpx 0; border-radius: 16rpx; font-weight: 600; font-size: 26rpx;
  background: #F5F5F4; color: #57534E; text-align: center;
}
.modal-btn-cancel:active { background: #E7E5E4; }
.modal-btn-ok {
  flex: 1; padding: 24rpx 0; border-radius: 16rpx; font-weight: 700; font-size: 26rpx; text-align: center;
}
.modal-btn-ok:active { opacity: 0.85; }
.modal-btn-primary { background: linear-gradient(135deg, #F59E0B, #F97316); color: #FFFFFF; }
.modal-btn-danger { background: linear-gradient(135deg, #EF4444, #DC2626); color: #FFFFFF; }

/* ===== 通知 ===== */
.toast-wrap {
  position: fixed; bottom: 48rpx; left: 50%; transform: translateX(-50%);
  padding: 20rpx 36rpx; border-radius: 99999rpx;
  display: flex; align-items: center; gap: 12rpx;
  z-index: 999; box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
  animation: slideUp 0.3s ease-out forwards;
}
.toast-success { background: #292524; }
.toast-error { background: #EF4444; }
.toast-icon { font-size: 24rpx; color: #FFFFFF; }
.toast-text { font-size: 24rpx; font-weight: 500; color: #FFFFFF; }
@keyframes slideUp {
  from { opacity: 0; transform: translateX(-50%) translateY(20rpx); }
  to { opacity: 1; transform: translateX(-50%) translateY(0); }
}
