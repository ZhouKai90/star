/* 导航栏（复用 history 样式） */
.nav-header {
  background: #ffffff;
  padding: 64rpx 32rpx 24rpx;
  border-bottom: 2rpx solid #f1f5f9;
  position: sticky;
  top: 0;
  z-index: 30;
}
.nav-inner {
  max-width: 580rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 99999rpx;
}
.nav-back:active {
  background: #f1f5f9;
}
.nav-back-arrow {
  font-size: 36rpx;
  color: #64748b;
}
.nav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #334155;
}
.nav-placeholder {
  width: 64rpx;
}

/* ===== 内容区 ===== */
.content-area {
  padding: 24rpx 32rpx 80rpx;
  max-width: 580rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 分区卡片 ===== */
.manage-section {
  background: #ffffff;
  border-radius: 24rpx;
  border: 2rpx solid #f1f5f9;
  overflow: hidden;
}
.manage-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 0;
}
.manage-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

/* 分类徽章 */
.badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 99999rpx;
}
.badge-blue { background: #eff6ff; color: #2563eb; }
.badge-red { background: #fef2f2; color: #dc2626; }
.badge-pink { background: #fdf2f8; color: #db2777; }

/* ===== 分类切换标签（紧凑） ===== */
.type-tabs {
  display: flex;
  gap: 6rpx;
  margin: 20rpx 32rpx 0;
  padding: 6rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
}
.type-tab {
  flex: 1;
  padding: 14rpx 0;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  color: #64748b;
  transition: all 0.2s;
}
.type-tab:active {
  opacity: 0.7;
}
.type-tab-active {
  background: #ffffff;
  color: #2563eb;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.type-tab-active-blue { color: #2563eb; }
.type-tab-active-red { color: #dc2626; }
.type-tab-active-pink { color: #db2777; }

/* ===== 添加栏（横排） ===== */
.add-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 16rpx 32rpx 0;
  padding: 12rpx 16rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  border: 2rpx solid #e2e8f0;
}
.add-bar-input {
  flex: 1;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #334155;
  min-width: 0;
  background: transparent;
}
.add-bar-input::placeholder {
  color: #94a3b8;
  font-size: 26rpx;
}
.add-bar-num {
  width: 120rpx;
  padding: 10rpx 0;
  font-size: 24rpx;
  color: #334155;
  text-align: center;
  background: #ffffff;
  border-radius: 8rpx;
  border: 2rpx solid #e2e8f0;
}
.add-bar-icon {
  flex-shrink: 0;
}
.add-bar-icon-value {
  width: 64rpx;
  height: 64rpx;
  background: #ffffff;
  border-radius: 10rpx;
  border: 2rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.add-bar-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
}
.add-bar-btn:active {
  opacity: 0.8;
}
.btn-blue { background: #3b82f6; }
.btn-red { background: #ef4444; }
.btn-pink { background: #ec4899; }

/* ===== 项目列表 ===== */
.item-list {
  margin-top: 16rpx;
  border-top: 2rpx solid #f1f5f9;
}
.list-empty {
  display: block;
  padding: 40rpx 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}
.item-row {
  border-bottom: 2rpx solid #f8fafc;
}
.item-row:last-child {
  border-bottom: none;
}
.item-row-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 32rpx;
}
.item-row-inner:active {
  background: #f8fafc;
}
.item-row-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}
.item-icon {
  font-size: 30rpx;
  width: 56rpx;
  text-align: center;
  flex-shrink: 0;
}
.item-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #334155;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.tag-earn { background: #fefce8; color: #a16207; }
.tag-deduct { background: #fef2f2; color: #dc2626; }
.tag-spend { background: #eff6ff; color: #2563eb; }
.item-row-actions {
  display: flex;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.action-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}
.action-btn:active {
  background: #f1f5f9;
}
.action-icon {
  font-size: 24rpx;
  opacity: 0.5;
}

/* ===== 编辑行（inline editing） ===== */
.edit-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  background: #f8fafc;
}
.edit-input {
  flex: 1;
  padding: 12rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #ffffff;
  min-width: 0;
}
.edit-input-num {
  width: 96rpx;
  padding: 12rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #ffffff;
  text-align: center;
}
.edit-actions {
  display: flex;
  gap: 4rpx;
}
.edit-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.edit-btn-save { color: #22c55e; background: #f0fdf4; }
.edit-btn-cancel { color: #94a3b8; background: #f1f5f9; }

/* ===== 数据管理 - 菜单行 ===== */
.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}
.menu-row:active {
  background: #f8fafc;
}
.menu-row.menu-row-danger:active {
  background: #fef2f2;
}
.menu-row-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.menu-icon {
  font-size: 30rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.menu-icon-blue { background: #eff6ff; }
.menu-icon-yellow { background: #fefce8; }
.menu-icon-red { background: #fef2f2; }
.menu-row-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.menu-row-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}
.menu-row-title-danger {
  color: #dc2626;
}
.menu-row-desc {
  font-size: 22rpx;
  color: #94a3b8;
}
.menu-row-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.menu-input-num {
  width: 160rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  font-size: 24rpx;
  color: #334155;
  text-align: center;
}
.menu-sm-btn {
  padding: 14rpx 24rpx;
  border-radius: 10rpx;
  background: #64748b;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}
.menu-sm-btn:active {
  opacity: 0.8;
}
.menu-arrow {
  font-size: 32rpx;
  color: #94a3b8;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.menu-arrow-danger {
  color: #fca5a5;
}
.menu-divider {
  height: 2rpx;
  background: #f1f5f9;
  margin: 0 32rpx;
}

/* ===== 模态框 ===== */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0,0,0,0.5);
}
.modal-box {
  background: #ffffff;
  border-radius: 24rpx;
  width: 100%;
  max-width: 480rpx;
  padding: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.2);
}
.modal-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.modal-warn-emoji { font-size: 36rpx; }
.modal-title { font-size: 32rpx; font-weight: 700; color: #1e293b; }
.modal-title-danger { color: #dc2626; }
.modal-message { font-size: 24rpx; color: #475569; margin-bottom: 40rpx; line-height: 1.5; }
.modal-actions { display: flex; gap: 16rpx; }
.modal-btn { flex: 1; padding: 24rpx 0; border-radius: 12rpx; font-weight: 700; font-size: 24rpx; text-align: center; }
.modal-btn:active { opacity: 0.8; }
.modal-btn-cancel { background: #f1f5f9; color: #334155; }
.modal-btn-confirm { background: #3b82f6; color: #ffffff; box-shadow: 0 4rpx 12rpx rgba(59,130,246,0.3); }
.modal-btn-danger { background: #ef4444; color: #ffffff; box-shadow: 0 4rpx 12rpx rgba(239,68,68,0.3); }

/* ===== 通知 ===== */
.notification {
  position: fixed;
  bottom: 48rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 20rpx 40rpx;
  border-radius: 99999rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 50;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
  animation: bounceIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}
.notification-success { background: #1e293b; }
.notification-error { background: #ef4444; }
.notification-icon { font-size: 24rpx; color: #ffffff; }
.notification-text { font-size: 24rpx; font-weight: 500; color: #ffffff; }

@keyframes bounceIn {
  from { opacity: 0; transform: scale(0.9) translateX(-50%); }
  to { opacity: 1; transform: scale(1) translateX(-50%); }
}
