.header-area-sm {
  background: linear-gradient(165deg, #FB923C, #F97316);
  padding: 0 32rpx 28rpx;
}

.page-content {
  padding: 32rpx;
  max-width: 580rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hub-card {
  background: #FFFFFF;
  padding: 32rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.hub-card:active { background: #FAFAF9; }
.hub-card-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}
.hub-icon {
  font-size: 32rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.hub-icon-blue { background: #EFF6FF; }
.hub-icon-green { background: #F0FDF4; }
.hub-icon-yellow { background: #FFFBEB; }
.hub-card-info { display: flex; flex-direction: column; gap: 6rpx; }
.hub-card-title { font-size: 30rpx; font-weight: 700; color: #292524; }
.hub-card-desc { font-size: 24rpx; color: #A8A29E; }
.hub-arrow { font-size: 36rpx; color: #D6D3D1; font-weight: 300; flex-shrink: 0; margin-left: 16rpx; }
