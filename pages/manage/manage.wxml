<view class="page">
  <view class="header-area-sm" style="padding-top:{{headerTopPadding}}rpx">
    <view class="page-header-inner">
      <view class="page-header-back" bindtap="goBack">
        <text class="page-header-back-icon">‹</text>
      </view>
      <text class="page-header-title" style="color:#FFF;">设置</text>
      <view class="page-header-actions"></view>
    </view>
  </view>

  <view class="page-content" style="margin-top:32rpx;">
    <view class="hub-card" bindtap="goToItems">
      <view class="hub-card-left">
        <view class="hub-icon hub-icon-blue">
          <text>📋</text>
        </view>
        <view class="hub-card-info">
          <text class="hub-card-title">项目管理</text>
          <text class="hub-card-desc">管理任务、坏习惯和奖励项目</text>
        </view>
      </view>
      <text class="hub-arrow">›</text>
    </view>

    <view class="hub-card" bindtap="goToHistory">
      <view class="hub-card-left">
        <view class="hub-icon hub-icon-green">
          <text>📜</text>
        </view>
        <view class="hub-card-info">
          <text class="hub-card-title">历史记录</text>
          <text class="hub-card-desc">查看所有星星收支记录</text>
        </view>
      </view>
      <text class="hub-arrow">›</text>
    </view>

    <view class="hub-card" bindtap="goToData">
      <view class="hub-card-left">
        <view class="hub-icon hub-icon-yellow">
          <text>⚙️</text>
        </view>
        <view class="hub-card-info">
          <text class="hub-card-title">数据管理</text>
          <text class="hub-card-desc">查看记录、调整星星、重置数据</text>
        </view>
      </view>
      <text class="hub-arrow">›</text>
    </view>
  </view>
</view>
