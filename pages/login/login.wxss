.login-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #FFF7ED 0%, #FFEDD5 50%, #FFF 100%);
  padding: 64rpx;
  box-sizing: border-box;
  position: relative;
}
.login-box {
  width: 100%;
  max-width: 480rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.login-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}
.login-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #292524;
  margin-bottom: 8rpx;
}
.login-subtitle {
  font-size: 24rpx;
  color: #A8A29E;
  margin-bottom: 64rpx;
}
.login-form { width: 100%; display: flex; flex-direction: column; gap: 24rpx; }
.login-input {
  width: 100%;
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
  background: #FAFAF9;
  border: 2rpx solid #E7E5E4;
  font-size: 28rpx;
  color: #292524;
  text-align: center;
  box-sizing: border-box;
  height: 88rpx;
}
.login-input:focus { border-color: #F97316; background: #FFFFFF; }
.login-btn {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #F59E0B, #F97316);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(249,115,22,0.3);
  border: none;
  height: 88rpx;
  display: flex; align-items: center; justify-content: center;
}
.login-btn:active { opacity: 0.85; transform: scale(0.97); }
.login-btn[disabled] { opacity: 0.5; box-shadow: none; transform: none; }
.login-hint { font-size: 22rpx; color: #A8A29E; margin-top: 48rpx; text-align: center; }
.login-error {
  position: absolute; bottom: 120rpx; padding: 16rpx 32rpx;
  background: #FEF2F2; border-radius: 12rpx; color: #DC2626;
  font-size: 24rpx; max-width: 480rpx; text-align: center;
}
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
