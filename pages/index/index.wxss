/* ===== 页面布局 ===== */
.page-inner {
  padding: 0 32rpx;
  max-width: 750rpx;
  margin: 0 auto;
  box-sizing: border-box;
}

/* ===== 顶部储蓄罐卡片 ===== */
.header-card {
  position: relative;
  overflow: hidden;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 140, 0, 0.18);
}

.header-bg-image {
  display: block;
  width: 100%;
}

.header-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}

/* 对齐 banner 左上角小星星 */
.header-title {
  position: absolute;
  left: 12%;
  top: 10.5%;
  transform: translateY(-50%);
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.header-setting {
  position: absolute;
  top: 6%;
  right: 5%;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-setting-icon {
  font-size: 32rpx;
  opacity: 0.9;
}

.header-setting-icon:active {
  opacity: 0.5;
}

/* 对齐 banner 中央大星星，数字在其正上方 */
.star-number {
  position: absolute;
  left: 49%;
  top: 45%;
  transform: translate(-50%, -100%);
  font-size: 110rpx;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1;
  transition: transform 0.3s;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  text-align: center;
}

.star-number-bounce {
  transform: translate(-50%, -100%) scale(1.12);
}

.star-label {
  position: absolute;
  left: 5%;
  bottom: 5%;
  transform: none;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
  white-space: nowrap;
}

/* ===== 日期导航卡片 ===== */
.date-bar-card {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.date-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-btn:active {
  opacity: 0.5;
}

.date-btn-disabled {
  opacity: 0.25;
  pointer-events: none;
}

.date-arrow {
  font-size: 36rpx;
  color: #999999;
  font-weight: 400;
  line-height: 1;
}

.date-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
  text-align: center;
}

.date-label:active {
  opacity: 0.5;
}

/* ===== 三标签分段导航 ===== */
.tab-bar-card {
  display: flex;
  align-items: stretch;
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab-segment {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 18rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: all 0.2s;
}

.tab-segment:active {
  opacity: 0.85;
}

.tab-segment-emoji {
  font-size: 26rpx;
  line-height: 1;
}

.tab-emoji-deduct {
  color: #FF4D4F;
  font-weight: 700;
  font-size: 22rpx;
}

.tab-segment-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #666666;
}

.tab-segment-divider {
  width: 2rpx;
  background: #F0F0F0;
  margin: 12rpx 0;
  flex-shrink: 0;
}

.tab-segment-earn-active {
  background: linear-gradient(135deg, #FF9800, #FF8C00);
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.35);
}

.tab-segment-earn-active .tab-segment-label {
  color: #FFFFFF;
}

.tab-segment-deduct-active {
  background: linear-gradient(135deg, #FF6B6B, #FF4D4F);
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3);
}

.tab-segment-deduct-active .tab-segment-label {
  color: #FFFFFF;
}

.tab-segment-deduct-active .tab-emoji-deduct {
  color: #FFFFFF;
}

.tab-segment-spend-active {
  background: linear-gradient(135deg, #FF85B3, #EC4899);
  box-shadow: 0 4rpx 12rpx rgba(236, 72, 153, 0.3);
}

.tab-segment-spend-active .tab-segment-label {
  color: #FFFFFF;
}

/* ===== 内容区域 ===== */
.content-wrap {
  padding-bottom: 100rpx;
}

/* ===== 自定义输入卡片 ===== */
.custom-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.custom-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 20rpx;
  display: block;
}

.custom-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.custom-input {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #FEF6E9;
  border: none;
  font-size: 24rpx;
  color: #333333;
  height: 72rpx;
  box-sizing: border-box;
}

.custom-input-num {
  width: 120rpx;
  text-align: center;
  flex-shrink: 0;
}

.custom-btn {
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  font-weight: 700;
  font-size: 24rpx;
  white-space: nowrap;
  height: 72rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.custom-btn:active {
  opacity: 0.85;
}

.earn-btn {
  background: #FF9800;
  color: #FFFFFF;
}

.deduct-btn {
  background: #FF4D4F;
  color: #FFFFFF;
}

.spend-btn {
  background: #EC4899;
  color: #FFFFFF;
}

/* ===== 任务列表卡片（合并） ===== */
.task-list-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.task-item {
  animation: fadeIn 0.3s ease-out forwards;
}

.task-item:not(:last-child) {
  border-bottom: 2rpx solid #F5F5F5;
}

.task-item-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  transition: background 0.15s;
}

.task-item-inner:active {
  background: #FAFAFA;
}

.item-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.item-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.icon-wrap-earn {
  background: #FFF8E7;
}

.icon-wrap-deduct {
  background: #FFF0F0;
}

.icon-wrap-spend {
  background: #FFF0F6;
}

.icon-wrap-dim {
  background: #F5F5F5;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
  display: block;
  line-height: 1.3;
}

.item-title-done {
  color: #16a34a;
}

.item-title-dim {
  color: #BBBBBB;
}

.item-sub {
  font-size: 22rpx;
  color: #999999;
  display: block;
  margin-top: 6rpx;
}

.item-sub-done {
  color: #22c55e;
  font-weight: 500;
}

.item-sub-warn {
  color: #FF4D4F;
  font-weight: 600;
}

.item-sub-dim {
  color: #CCCCCC;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

/* ===== 数值徽章 ===== */
.value-badge {
  padding: 10rpx 20rpx;
  border-radius: 99999rpx;
  font-weight: 700;
  font-size: 24rpx;
  white-space: nowrap;
}

.value-badge-earn {
  background: #FFF3E0;
  color: #FF9800;
}

.value-badge-deduct {
  background: #FFF0F0;
  color: #FF4D4F;
}

.value-badge-spend {
  background: #FFF0F6;
  color: #EC4899;
}

.value-badge-dim {
  background: #F5F5F5;
  color: #BBBBBB;
}

/* ===== 撤销按钮 ===== */
.revoke-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 99999rpx;
  background: #FFFFFF;
  border: 2rpx solid #EEEEEE;
  display: flex;
  align-items: center;
  justify-content: center;
}

.revoke-btn:active {
  background: #FFF0F0;
}

.revoke-icon {
  font-size: 20rpx;
  color: #999999;
  line-height: 1;
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-state-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-state-text {
  font-size: 26rpx;
  color: #999999;
}

/* ===== 模态框 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-sheet {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-radius: 32rpx;
  width: 85%;
  padding: 40rpx 32rpx 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
}

.modal-handle {
  width: 48rpx;
  height: 6rpx;
  border-radius: 99rpx;
  background: #DDDDDD;
  margin: 0 auto 24rpx;
}

.modal-emoji {
  font-size: 56rpx;
  display: block;
  margin-bottom: 16rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.modal-title-danger {
  color: #FF4D4F;
}

.modal-desc {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 36rpx;
  line-height: 1.5;
}

.modal-btns {
  display: flex;
  gap: 16rpx;
}

.modal-btn-cancel {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-weight: 600;
  font-size: 26rpx;
  background: #F5F5F5;
  color: #666666;
  text-align: center;
}

.modal-btn-cancel:active {
  background: #EEEEEE;
}

.modal-btn-ok {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-weight: 700;
  font-size: 26rpx;
  text-align: center;
}

.modal-btn-ok:active {
  opacity: 0.85;
}

.modal-btn-primary {
  background: linear-gradient(135deg, #FF9800, #FF8C00);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 152, 0, 0.3);
}

.modal-btn-danger {
  background: linear-gradient(135deg, #FF6B6B, #FF4D4F);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 77, 79, 0.3);
}

/* ===== 底部通知 ===== */
.toast-wrap {
  position: fixed;
  bottom: 48rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 20rpx 36rpx;
  border-radius: 99999rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 999;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  animation: slideUp 0.3s ease-out forwards;
  max-width: 80vw;
}

.toast-success {
  background: #333333;
}

.toast-error {
  background: #FF4D4F;
}

.toast-icon {
  font-size: 24rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.toast-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
  white-space: nowrap;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}
