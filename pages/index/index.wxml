<view class="page">

  <view class="page-inner" style="padding-top:{{headerTopPadding}}rpx">

    <!-- ===== 顶部储蓄罐卡片 ===== -->
    <view class="header-card">
      <image class="header-bg-image" src="../../images/banner.png" mode="widthFix"></image>
      <view class="header-content">
        <text class="header-title">星星储蓄罐</text>
        <view class="header-setting" bindtap="goToManage">
          <text class="header-setting-icon">•••</text>
        </view>
        <text class="star-number {{showConfetti ? 'star-number-bounce' : ''}}">{{stars}}</text>
      </view>
    </view>

    <!-- ===== 日期导航 ===== -->
    <view class="date-bar-card">
      <view class="date-btn" bindtap="prevDay">
        <text class="date-arrow">‹</text>
      </view>
      <text class="date-label" bindtap="goToHistory">{{dateLabel}}</text>
      <view class="date-btn {{canGoForward ? '' : 'date-btn-disabled'}}" bindtap="nextDay">
        <text class="date-arrow">›</text>
      </view>
    </view>

    <view class="summary-strip">
      <view class="summary-pill summary-pill-earn">
        <text class="summary-pill-label">今日赚取</text>
        <text class="summary-pill-value">+{{dayEarnTotal}}</text>
      </view>
      <view class="summary-pill summary-pill-deduct">
        <text class="summary-pill-label">今日支出</text>
        <text class="summary-pill-value">-{{dayDeductTotal}}</text>
      </view>
      <view class="summary-pill summary-pill-spend">
        <text class="summary-pill-label">可换礼物</text>
        <text class="summary-pill-value">{{affordableRewardCount}} 个</text>
      </view>
    </view>

    <!-- ===== 三标签导航 ===== -->
    <view class="tab-bar-card">
      <view
        class="tab-segment {{activeTab === 'earn' ? 'tab-segment-earn-active' : ''}}"
        bindtap="switchTab" data-tab="earn"
      >
        <text class="tab-segment-emoji">⭐</text>
        <text class="tab-segment-label">赚星星</text>
      </view>
      <view
        class="tab-segment {{activeTab === 'deduct' ? 'tab-segment-deduct-active' : ''}}"
        bindtap="switchTab" data-tab="deduct"
      >
        <text class="tab-segment-emoji tab-emoji-deduct">✕</text>
        <text class="tab-segment-label">扣星星</text>
      </view>
      <view class="tab-segment-divider"></view>
      <view
        class="tab-segment {{activeTab === 'spend' ? 'tab-segment-spend-active' : ''}}"
        bindtap="switchTab" data-tab="spend"
      >
        <text class="tab-segment-emoji">🎁</text>
        <text class="tab-segment-label">换礼物</text>
      </view>
    </view>

    <!-- ===== 内容区域 ===== -->
    <view class="content-wrap">

      <!-- ===== 赚星星 Tab ===== -->
      <view wx:if="{{activeTab === 'earn'}}" class="scale-in">
        <view class="custom-card {{customPanelExpanded ? 'custom-card-expanded' : ''}}">
          <view class="custom-card-head" bindtap="toggleCustomPanel">
            <view class="custom-card-head-main">
              <text class="custom-card-title">{{customPanelTitle}}</text>
              <text class="custom-card-desc">{{customPanelDesc}}</text>
            </view>
            <view class="custom-card-toggle">
              <text class="custom-card-toggle-text">{{customPanelExpanded ? '收起' : '展开'}}</text>
              <text class="custom-card-toggle-icon {{customPanelExpanded ? 'custom-card-toggle-icon-open' : ''}}">⌄</text>
            </view>
          </view>
          <view wx:if="{{customPanelExpanded}}" class="custom-panel-body">
            <view class="custom-row">
              <input class="custom-input flex-1" placeholder="输入奖励理由 (例如：主动帮忙)" value="{{customEarnReason}}" bindinput="onEarnReasonInput" />
              <input class="custom-input custom-input-num" type="number" placeholder="星数" value="{{customEarnValue}}" bindinput="onEarnValueInput" />
              <view class="custom-btn earn-btn" bindtap="handleCustomEarn">
                <text>{{customPanelActionText}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{displayTasks.length === 0}}" class="empty-state">
          <text class="empty-state-icon">📋</text>
          <text class="empty-state-text">还没有任务哦，去设置里添加吧！</text>
        </view>
        <view wx:else class="task-list-card">
          <view wx:for="{{displayTasks}}" wx:key="id" class="task-item animate-fade-in" style="animation-delay:{{index * 0.05}}s">
            <view class="task-item-inner" bindtap="handleEarnStar" data-id="{{item.id}}">
              <view class="item-left">
                <view class="item-icon-wrap icon-wrap-earn">{{item.icon}}</view>
                <view class="item-info">
                  <text class="item-title {{item.isCompleted ? 'item-title-done' : ''}}">{{item.title}}</text>
                  <text class="item-sub {{item.isCompleted ? 'item-sub-done' : ''}}">{{item.statusText}}</text>
                </view>
              </view>
              <view class="item-right">
                <view class="value-badge value-badge-earn">+{{item.value}} ⭐</view>
                <view wx:if="{{item.isCompleted}}" class="revoke-btn" catchtap="handleRevokeEarn" data-id="{{item.id}}" data-title="{{item.title}}" data-value="{{item.value}}">
                  <text class="revoke-icon">↩</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- ===== 扣星星 Tab ===== -->
      <view wx:elif="{{activeTab === 'deduct'}}" class="scale-in">
        <view class="custom-card {{customPanelExpanded ? 'custom-card-expanded' : ''}}">
          <view class="custom-card-head" bindtap="toggleCustomPanel">
            <view class="custom-card-head-main">
              <text class="custom-card-title">{{customPanelTitle}}</text>
              <text class="custom-card-desc">{{customPanelDesc}}</text>
            </view>
            <view class="custom-card-toggle">
              <text class="custom-card-toggle-text">{{customPanelExpanded ? '收起' : '展开'}}</text>
              <text class="custom-card-toggle-icon {{customPanelExpanded ? 'custom-card-toggle-icon-open' : ''}}">⌄</text>
            </view>
          </view>
          <view wx:if="{{customPanelExpanded}}" class="custom-panel-body">
            <view class="custom-row">
              <input class="custom-input flex-1" placeholder="输入扣星理由 (例如：乱发脾气)" value="{{customDeductReason}}" bindinput="onDeductReasonInput" />
              <input class="custom-input custom-input-num" type="number" placeholder="星数" value="{{customDeductValue}}" bindinput="onDeductValueInput" />
              <view class="custom-btn deduct-btn" bindtap="handleCustomDeduct">
                <text>{{customPanelActionText}}</text>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{displayBadHabits.length === 0}}" class="empty-state">
          <text class="empty-state-icon">😅</text>
          <text class="empty-state-text">还没有坏习惯选项哦，去设置里添加吧！</text>
        </view>
        <view wx:else class="task-list-card">
          <view wx:for="{{displayBadHabits}}" wx:key="id" class="task-item animate-fade-in" style="animation-delay:{{index * 0.05}}s">
            <view class="task-item-inner" bindtap="handleDeductStar" data-id="{{item.id}}" data-title="{{item.title}}" data-value="{{item.value}}">
              <view class="item-left">
                <view class="item-icon-wrap icon-wrap-deduct">{{item.icon}}</view>
                <view class="item-info">
                  <text class="item-title">{{item.title}}</text>
                  <text class="item-sub {{item.goesNegative ? 'item-sub-warn' : ''}}">
                    <text wx:if="{{item.goesNegative}}">⚠️ 星星将不够扣</text>
                    <text wx:else>扣后剩余 {{item.nextStars}} 颗</text>
                  </text>
                </view>
              </view>
              <view class="value-badge value-badge-deduct">-{{item.value}} ⭐</view>
            </view>
          </view>
        </view>
      </view>

      <!-- ===== 换礼物 Tab ===== -->
      <view wx:else class="scale-in">
        <view class="custom-card {{customPanelExpanded ? 'custom-card-expanded' : ''}}">
          <view class="custom-card-head" bindtap="toggleCustomPanel">
            <view class="custom-card-head-main">
              <text class="custom-card-title">{{customPanelTitle}}</text>
              <text class="custom-card-desc">{{customPanelDesc}}</text>
            </view>
            <view class="custom-card-toggle">
              <text class="custom-card-toggle-text">{{customPanelExpanded ? '收起' : '展开'}}</text>
              <text class="custom-card-toggle-icon {{customPanelExpanded ? 'custom-card-toggle-icon-open' : ''}}">⌄</text>
            </view>
          </view>
          <view wx:if="{{customPanelExpanded}}" class="custom-panel-body">
            <view class="custom-row">
              <input class="custom-input flex-1" placeholder="输入兑换理由 (例如：看动画)" value="{{customSpendReason}}" bindinput="onSpendReasonInput" />
              <input class="custom-input custom-input-num" type="number" placeholder="星数" value="{{customSpendValue}}" bindinput="onSpendValueInput" />
              <view class="custom-btn spend-btn" bindtap="handleCustomSpend">
                <text>{{customPanelActionText}}</text>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{displayRewards.length === 0}}" class="empty-state">
          <text class="empty-state-icon">🎀</text>
          <text class="empty-state-text">还没有奖励哦，去设置里添加吧！</text>
        </view>
        <view wx:else class="task-list-card">
          <view wx:for="{{displayRewards}}" wx:key="id" class="task-item animate-fade-in" style="animation-delay:{{index * 0.05}}s">
            <view class="task-item-inner {{item.canAfford ? '' : 'item-disabled'}}" bindtap="handleSpendStar" data-id="{{item.id}}" data-title="{{item.title}}" data-cost="{{item.cost}}">
              <view class="item-left">
                <view class="item-icon-wrap {{item.canAfford ? 'icon-wrap-spend' : 'icon-wrap-dim'}}">{{item.icon}}</view>
                <view class="item-info">
                  <text class="item-title {{item.canAfford ? '' : 'item-title-dim'}}">{{item.title}}</text>
                  <text class="item-sub {{item.canAfford ? '' : 'item-sub-dim'}}">{{item.canAfford ? '点击兑换' : '星星还不够哦'}}</text>
                </view>
              </view>
              <view class="value-badge {{item.canAfford ? 'value-badge-spend' : 'value-badge-dim'}}">{{item.cost}} ⭐</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 模态框 ===== -->
  <view wx:if="{{showModal}}" class="modal-overlay" catchtouchmove="preventMove">
    <view class="modal-sheet animate-bounce-in">
      <view class="modal-handle"></view>
      <text class="modal-emoji">{{modalIsDanger ? '⚠️' : (modalActionType === 'earn' || modalActionType === 'customEarn' ? '⭐' : '🎉')}}</text>
      <text class="modal-title {{modalIsDanger ? 'modal-title-danger' : ''}}">{{modalTitle}}</text>
      <text class="modal-desc">{{modalMessage}}</text>
      <view class="modal-btns">
        <view class="modal-btn-cancel" bindtap="handleModalCancel">
          <text>{{modalCancelText}}</text>
        </view>
        <view class="modal-btn-ok {{modalIsDanger ? 'modal-btn-danger' : 'modal-btn-primary'}}" bindtap="handleModalConfirm">
          <text>{{modalConfirmText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 底部通知 ===== -->
  <view wx:if="{{notification}}" class="toast-wrap {{notification.type === 'error' ? 'toast-error' : 'toast-success'}}">
    <text class="toast-icon">{{notification.type === 'error' ? '✕' : '✓'}}</text>
    <text class="toast-text">{{notification.msg}}</text>
  </view>
</view>
